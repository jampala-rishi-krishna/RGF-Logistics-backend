# Copy to .env and fill in real values yourself - never commit .env, never paste real
# values into chat.

# Neon Postgres - POOLED variant. Used by the running app (database.py's SQLAlchemy engine)
# for normal runtime queries - better suited to many short-lived serverless-style connections.
DATABASE_URL=

# Neon Postgres - DIRECT (non-pooled) variant. Used ONLY by Alembic (migrations/env.py) to run
# schema migrations - migrations shouldn't run through a connection pooler.
DATABASE_URL_DIRECT=

# Zoho Inventory OAuth (server-side only)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com
ZOHO_DAILY_BUDGET=4000
ZOHO_ORG_DAILY_LIMIT=10000
# Only applies while the startup restore of today's Zoho usage from Neon has failed: max SO detail calls allowed until it succeeds.
ZOHO_FAILSAFE_SO_DETAIL_CAP=50
ZOHO_USAGE_TZ=Asia/Manila
ZOHO_SCOPES=ZohoInventory.salesorders.READ,ZohoInventory.packages.READ,ZohoInventory.transferorders.READ,ZohoInventory.inventoryadjustments.READ,ZohoInventory.purchasereceives.READ,ZohoInventory.invoices.READ

# Zoho Sales Order lock-only OAuth app. Same accounts/API domain and organization as above.
ZOHO_LOCK_CLIENT_ID=
ZOHO_LOCK_CLIENT_SECRET=
ZOHO_LOCK_REFRESH_TOKEN=
ZOHO_SO_LOCK_CONFIGURATION_ID=
ZOHO_SO_LOCK_API_BASE=https://www.zohoapis.com/inventory/v1
# webhook (recommended): lock through the IT-provided Zoho incoming webhook; api: direct lock API fallback.
# The webhook URL contains the API key - keep it secret and never log it.
ZOHO_SO_LOCK_MODE=webhook
ZOHO_SO_LOCK_WEBHOOK_URL=

# OpenAI - powers routers/agent.py's tool-calling loop (see services and the agent router).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Cartrack Fleet API (Philippines) - polled every CARTRACK_POLL_INTERVAL_SECONDS by
# services/cartrack_poller.py.
CARTRACK_USERNAME=
CARTRACK_API_KEY=
CARTRACK_BASE_URL=https://fleetapi-ph.cartrack.com
CARTRACK_POLL_INTERVAL_SECONDS=15

# OpenRouteService - geocoding (Pelias), distance/duration matrix, and road geometry for
# routers/optimization.py and routers/routes.py.
ORS_API_KEY=

# Mapbox - primary traffic-aware geocoding, matrix, and directions provider.
# Server-only credential. Never expose this as a Vite/VITE_* variable.
MAPBOX_SERVER_TOKEN=
# Legacy alias; migrate deployments to MAPBOX_SERVER_TOKEN.
MAPBOX_ACCESS_TOKEN=
MAPBOX_ROUTING_ENABLED=true
MAPBOX_PROFILE=driving-traffic
MAPBOX_MATRIX_BATCH_SIZE=5

# Temporary planning estimates only; these are not RGF accounting/payroll costs.
# Route cost model. Per leg: fuel = km / FUEL_KM_PER_LITER x DIESEL_PRICE; distance cost = km x DISTANCE_COST_PER_KM;
# time cost = hours x (driver [+ helper if assigned]); refrigeration = reefer hours x L/h x DIESEL_PRICE.
ROUTE_DIESEL_PRICE_PER_LITER=95          # Metro Manila average diesel, week of Oct 6-12, 2026; update weekly
ROUTE_FUEL_KM_PER_LITER=7                # driving only (refrigeration is costed separately)
ROUTE_DRIVER_COST_PER_HOUR=120           # NCR minimum P755/day / 8h ~ P94/h + statutory contributions and 13th month
ROUTE_HELPER_COST_PER_HOUR=120           # applied only when the assignment has a helper
ROUTE_DISTANCE_COST_PER_KM=5             # maintenance/tyres/depreciation
ROUTE_REFRIGERATION_LITERS_PER_HOUR_CHILLED=0.8   # estimate for small engine-driven reefer units
ROUTE_REFRIGERATION_LITERS_PER_HOUR_FROZEN=1.2    # estimate
ROUTE_REFRIGERATION_ON_RETURN_LEG=false  # truck usually returns empty
# Tolls: Google returns the Class 1 (car/SUV) fee. TRB Class 2 (2-axle trucks incl. our 6-wheeler reefers) = 2.0x,
# Class 3 (large trucks) = 3.0x. A leg with a toll but no Google price shows "fee unknown" and is left out of totals.
ROUTE_TOLLS_ENABLED=true
ROUTE_TOLL_VEHICLE_CLASS=2
ROUTE_TOLL_CLASS2_MULTIPLIER=2.0
ROUTE_TOLL_CLASS3_MULTIPLIER=3.0
ROUTE_BALANCED_TIME_WEIGHT=0.5
ROUTE_BALANCED_DISTANCE_WEIGHT=0.2
ROUTE_BALANCED_COST_WEIGHT=0.3

# HMAC secret used to sign/verify JWTs (auth/security.py). Generate your own random value,
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
JWT_SECRET=
JWT_EXPIRE_MINUTES=480

# Local demo account provisioning only. Keep this in backend/.env, never commit it.
SEED_PASSWORD=

# Comma-separated list of origins the single CORS middleware in main.py should allow.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000
STAFF_DIRECTORY_SNAPSHOT_PATH=
N8N_API_KEY=
# WhatsApp/SMS n8n webhooks and the staff directory only. Email never uses n8n.
INTELLIFLEET_ASSIGNMENT_WEBHOOK_SECRET=
DISPATCH_N8N_DRIVER_BROADCAST_URL=
DISPATCH_N8N_CUSTOMER_NOTIFY_URL=
DISPATCH_N8N_INTERNAL_ESCALATION_URL=
GOOGLE_MAPS_API_KEY=replace-with-server-key
GOOGLE_MAPS_API_KEY=replace-with-server-side-google-key
GOOGLE_ROUTE_OPTIMIZATION_PROJECT=rarechain-logistics-508805

# Gmail API (server-side only) - powers the Communications > Gmail tab. This connects one
# operations mailbox via OAuth refresh token, not per-user login. Generate these from a
# Google Cloud OAuth client (Desktop or Web type) with the gmail.readonly (or gmail.modify)
# scope, then exchange an authorization code once via the OAuth flow to obtain a refresh
# token - the access token is derived from it automatically and cached in-process.
GMAIL_COMMS_CLIENT_ID=
GMAIL_COMMS_CLIENT_SECRET=
GMAIL_COMMS_REFRESH_TOKEN=

# Twilio (read-only WhatsApp logs)
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_WHATSAPP_FROM=whatsapp:+639171145694

# Optional sender identity for ALL outgoing IntelliFleet email (services/gmail_sender.py).
# GMAIL_FROM_ADDRESS must be a verified "Send mail as" alias of the mailbox the refresh token
# belongs to, or Gmail rewrites it to that mailbox. Defaults: mailbox address / "RareChain Logistics" / no Reply-To.
GMAIL_FROM_ADDRESS=
GMAIL_FROM_NAME=
GMAIL_REPLY_TO=

# Inbound Logistics email agent (services/logistics_email_agent.py). OFF by default so it cannot
# answer alongside the n8n agent; set true only at cutover, after the n8n workflow is deactivated.
LOGISTICS_AGENT_ENABLED=false
LOGISTICS_AGENT_POLL_SECONDS=60

# AI voice calls (services/voice_control.py): paused | active. Anything else = paused. An admin can
# pause/resume at runtime; a restart returns to this value. Keep paused until logistics approves.
VOICE_CALLS_DEFAULT=paused
