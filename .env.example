# Copy to .env and fill in real values yourself - never commit .env, never paste real
# values into chat.

# Neon Postgres - POOLED variant. Used by the running app (database.py's SQLAlchemy engine)
# for normal runtime queries - better suited to many short-lived serverless-style connections.
DATABASE_URL=

# Neon Postgres - DIRECT (non-pooled) variant. Used ONLY by Alembic (migrations/env.py) to run
# schema migrations - migrations shouldn't run through a connection pooler.
DATABASE_URL_DIRECT=

# Zoho Inventory OAuth (server-side only)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com
ZOHO_SCOPES=ZohoInventory.salesorders.READ,ZohoInventory.packages.READ,ZohoInventory.transferorders.READ,ZohoInventory.inventoryadjustments.READ,ZohoInventory.purchasereceives.READ,ZohoInventory.invoices.READ

# OpenAI - powers routers/agent.py's tool-calling loop (see services and the agent router).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# n8n delivery webhook for Load Planning email attachments (server-side only)
INTELLIFLEET_WEBHOOK_SECRET=

# Cartrack Fleet API (Philippines) - polled every CARTRACK_POLL_INTERVAL_SECONDS by
# services/cartrack_poller.py.
CARTRACK_USERNAME=
CARTRACK_API_KEY=
CARTRACK_BASE_URL=https://fleetapi-ph.cartrack.com
CARTRACK_POLL_INTERVAL_SECONDS=15

# OpenRouteService - geocoding (Pelias), distance/duration matrix, and road geometry for
# routers/optimization.py and routers/routes.py.
ORS_API_KEY=

# Mapbox - primary traffic-aware geocoding, matrix, and directions provider.
# Server-only credential. Never expose this as a Vite/VITE_* variable.
MAPBOX_SERVER_TOKEN=
# Legacy alias; migrate deployments to MAPBOX_SERVER_TOKEN.
MAPBOX_ACCESS_TOKEN=
MAPBOX_ROUTING_ENABLED=true
MAPBOX_PROFILE=driving-traffic
MAPBOX_MATRIX_BATCH_SIZE=5

# Temporary planning estimates only; these are not RGF accounting/payroll costs.
ROUTE_DISTANCE_COST_PER_KM=5
ROUTE_DRIVER_COST_PER_HOUR=100
ROUTE_FUEL_COST_PER_KM=21
ROUTE_REFRIGERATION_COST_PER_HOUR=0
ROUTE_FIXED_COST_PER_ROUTE=0
ROUTE_BALANCED_TIME_WEIGHT=0.5
ROUTE_BALANCED_DISTANCE_WEIGHT=0.2
ROUTE_BALANCED_COST_WEIGHT=0.3

# HMAC secret used to sign/verify JWTs (auth/security.py). Generate your own random value,
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
JWT_SECRET=
JWT_EXPIRE_MINUTES=480

# Local demo account provisioning only. Keep this in backend/.env, never commit it.
SEED_PASSWORD=

# Comma-separated list of origins the single CORS middleware in main.py should allow.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000
STAFF_DIRECTORY_SNAPSHOT_PATH=
N8N_API_KEY=
INTELLIFLEET_WEBHOOK_SECRET=
INTELLIFLEET_ASSIGNMENT_WEBHOOK_SECRET=
INTELLIFLEET_ASSIGNMENT_WEBHOOK_URL=
DISPATCH_N8N_DRIVER_BROADCAST_URL=
DISPATCH_N8N_CUSTOMER_NOTIFY_URL=
DISPATCH_N8N_INTERNAL_ESCALATION_URL=
INTERNAL_API_BASE_URL=
GOOGLE_MAPS_API_KEY=replace-with-server-key
GOOGLE_MAPS_API_KEY=replace-with-server-side-google-key
GOOGLE_ROUTE_OPTIMIZATION_PROJECT=rarechain-logistics-508805

# Gmail API (server-side only) - powers the Communications > Gmail tab. This connects one
# operations mailbox via OAuth refresh token, not per-user login. Generate these from a
# Google Cloud OAuth client (Desktop or Web type) with the gmail.readonly (or gmail.modify)
# scope, then exchange an authorization code once via the OAuth flow to obtain a refresh
# token - the access token is derived from it automatically and cached in-process.
GMAIL_COMMS_CLIENT_ID=
GMAIL_COMMS_CLIENT_SECRET=
GMAIL_COMMS_REFRESH_TOKEN=

# Twilio (read-only WhatsApp logs)
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_WHATSAPP_FROM=whatsapp:+639171145694
